{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts",
    "global-setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-metadata",
    "playwright-report",
    "test-results",
    "src"
  ]
}
