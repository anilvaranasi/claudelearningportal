# Copy to .env for LOCAL runs only. .env is git-ignored. Never commit real values.
#
# CI does not read this file: the same names are GitHub environment secrets.
#   environment "development": SN_DEV_INSTANCE, SN_DEV_USER, SN_DEV_PASS
#   environment "production":  SN_PROD_INSTANCE, SN_PROD_USER, SN_PROD_PASS

# Full URL including https://, no trailing slash
SN_DEV_INSTANCE=https://your-dev-instance.service-now.com
SN_DEV_USER=
SN_DEV_PASS=

# Optional Playwright tuning
# HEADLESS=false
# TIMEOUT_SECONDS=90
