{
  "name": "claudelearningportal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "AIUX application: ClaudeLearningPortal",
  "scripts": {
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "doctor": "aiux doctor",
    "dev": "now-sdk run dev",
    "deploy": "now-sdk install",
    "deploy:reinstall": "now-sdk install --reinstall",
    "transform": "now-sdk transform",
    "types": "now-sdk dependencies",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "lint": "eslint .",
    "agent:skills": "node scripts/setup-agent-skills.mjs",
    "postinstall": "node scripts/setup-agent-skills.mjs"
  },
  "dependencies": {
    "@servicenow/aiux": "latest",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.48.0",
    "@servicenow/glide": "27.0.5",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.0",
    "@servicenow/eslint-plugin-aiux-a11y": "latest",
    "@servicenow/eslint-plugin-aiux-app": "latest",
    "@servicenow/eslint-plugin-aiux-i18n": "latest",
    "@servicenow/eslint-plugin-aiux-ssr": "latest",
    "@servicenow/eslint-plugin-aiux-style": "latest",
    "@servicenow/agent-pack-aiux": "latest",
    "@servicenow/agent-pack-horizon-design-knowledge": "latest",
    "@servicenow/sdk": "latest",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@servicenow/aiux-components-condition-builder",
      "@servicenow/aiux-document-viewer",
      "@swc/core",
      "core-js",
      "isolated-vm",
      "libxmljs2",
      "sn-http-request"
    ]
  }
}
